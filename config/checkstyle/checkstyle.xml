<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <module name="SuppressWarningsFilter"/>
    <module name="TreeWalker">
        <module name="SuppressWarningsHolder"/>
        <module name="IllegalCatch">
            <property name="illegalClassNames" value="Throwable, Error, java.lang.Throwable, java.lang.Error"/>
        </module>
        <module name="EqualsHashCode"/>
        <module name="FallThrough"/>
        <module name="StringLiteralEquality"/>
        <module name="NoFinalizer"/>
        <module name="AvoidStarImport"/>
        <module name="UnusedImports"/>
        <module name="IllegalImport"/>
        <module name="RegexpSinglelineJava">
            <property name="format" value="System\.(out|err)\.|\.printStackTrace\(\)"/>
            <property name="message" value="Use the class's logger."/>
            <property name="ignoreComments" value="true"/>
        </module>
        <module name="RegexpSinglelineJava">
            <property name="format" value="^(?!\s*(import|package)\s).*\b(java|javax|dev\.moon)\.[a-z]+(\.[a-z]+)*\.[A-Z]"/>
            <property name="message" value="Import the type instead of writing its full name."/>
            <property name="ignoreComments" value="true"/>
        </module>
    </module>
</module>
